{
  "name": "zion-pdf",
  "private": true,
  "version": "1.10.7",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist:win:local": "npm run build && electron-builder --win nsis --publish never --config.extraMetadata.zionpdfLocalBuild=true",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "release": "node scripts/release.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "smoke": "node scripts/smoke-test.mjs",
    "test:chat-math": "node scripts/test-chat-math.mjs",
    "test:pdfium-probe": "node scripts/probe-pdfium.mjs",
    "test:font-policy": "node scripts/test-font-policy.mjs",
    "test:ocr": "node scripts/test-ocr.mjs",
    "test:document-files": "node scripts/test-document-files.mjs",
    "test:save-export": "node scripts/test-save-export.mjs",
    "test:live-editor": "node scripts/test-live-editor.mjs",
    "test:clipped-images": "node scripts/test-clipped-images.mjs",
    "test:font-sizes": "node scripts/test-font-sizes.mjs",
    "test:font-picker": "node scripts/test-font-picker.mjs",
    "test:word-layout": "node scripts/test-word-layout.mjs",
    "test:word-exam": "node scripts/test-word-exam.mjs",
    "test:pdf-composer": "node scripts/test-pdf-composer.mjs",
    "test:release-readiness": "node scripts/test-release-readiness.mjs",
    "converter:build": "node scripts/build-converter.mjs",
    "test:word-cancel": "node scripts/test-word-cancel.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "^9.15.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "mdast-util-from-markdown": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "productName": "Zion PDF",
  "description": "Zion PDF viewer and editor for Windows, macOS, and Linux",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukisa95/zion-pdf.git"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.zionpdf.reader",
    "productName": "Zion PDF",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/mammoth/mammoth.browser*.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zion PDF",
      "artifactName": "Zion-PDF-Setup.exe"
    },
    "portable": {
      "artifactName": "Zion-PDF-Portable.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Mukisa95",
      "repo": "zion-pdf"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "dist/.vite/license.md",
        "to": "licenses/THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "conversion/runtime",
        "to": "converter",
        "filter": [
          "**/*",
          "!**/.cache/**/*"
        ]
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "fileAssociations": [
        {
          "ext": [
            "docx",
            "doc"
          ],
          "name": "Word Document",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Zion-PDF-mac.${ext}",
      "x64ArchFiles": "Contents/Resources/converter/**"
    },
    "dmg": {
      "artifactName": "Zion-PDF-mac.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons",
      "synopsis": "A simple, clean PDF reader",
      "mimeTypes": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/msword"
      ],
      "executableName": "zion-pdf",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Zion-PDF-linux-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "Zion-PDF-linux-amd64.deb",
      "afterInstall": "build/linux/after-install.tpl",
      "afterRemove": "build/linux/after-remove.tpl"
    },
    "beforePack": "scripts/check-converter.cjs"
  },
  "desktopName": "zion-pdf.desktop",
  "overrides": {
    "katex": "$katex"
  }
}
